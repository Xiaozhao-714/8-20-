{
  "rewrites": [
    { "source": "/", "destination": "/workbench-mobile.html" },
    { "source": "/mobile", "destination": "/workbench-mobile.html" },
    { "source": "/desktop", "destination": "/workbench-desktop.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
